<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_d406" model="ir.ui.view">
        <field name="name">res.company.form.d406</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SAF-T D406"
                       invisible="country_code != 'RO'">
                    <field name="l10n_ro_d406_tax_accounting_basis"/>
                    <field name="l10n_ro_d406_tax_entity"/>
                    <field name="l10n_ro_d406_chart"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
