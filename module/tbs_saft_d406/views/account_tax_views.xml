<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tax_form_d406" model="ir.ui.view">
        <field name="name">account.tax.form.d406</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SAF-T D406"
                       invisible="country_code != 'RO'">
                    <field name="l10n_ro_d406_tax_type_id"/>
                    <field name="l10n_ro_d406_tax_code_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
