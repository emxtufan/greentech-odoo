<odoo>
  <record id="work_customers" model="ir.actions.act_window">
    <field name="name">Clienți - firma curentă</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('customer_rank','&gt;',0)]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0],'default_customer_rank':1,'res_partner_search_mode':'customer'}</field>
  </record>
  <record id="work_vendors" model="ir.actions.act_window">
    <field name="name">Furnizori - firma curentă</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('supplier_rank','&gt;',0)]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0],'default_supplier_rank':1,'res_partner_search_mode':'supplier'}</field>
  </record>
  <record id="work_sales" model="ir.actions.act_window">
    <field name="name">Facturi clienți - firma curentă</field><field name="res_model">account.move</field><field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('move_type','in',['out_invoice','out_refund'])]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0],'default_move_type':'out_invoice'}</field>
    <field name="view_id" ref="account.view_out_invoice_tree"/>
  </record>
  <record id="work_purchases" model="ir.actions.act_window">
    <field name="name">Facturi furnizori - firma curentă</field><field name="res_model">account.move</field><field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('move_type','in',['in_invoice','in_refund'])]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0],'default_move_type':'in_invoice'}</field>
    <field name="view_id" ref="account.view_in_invoice_tree"/>
  </record>
  <record id="work_banks" model="ir.actions.act_window">
    <field name="name">Casă și bănci - firma curentă</field><field name="res_model">account.journal</field><field name="view_mode">kanban,list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('type','in',['bank','cash'])]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0]}</field>
  </record>
  <record id="work_ledger" model="ir.actions.act_window">
    <field name="name">Registru casă/bancă - firma curentă</field><field name="res_model">account.move.line</field><field name="view_mode">list,pivot,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('parent_state','=','posted'),('account_id.account_type','=','asset_cash')]</field>
    <field name="context">{'group_by':['account_id'],'create':False}</field>
    <field name="help" type="html"><p>Operațiunile contabile din backup și operațiunile noi. Filtrează perioada și exportă lista. Acest registru nu reprezintă extrasele originale emise de bancă.</p></field>
  </record>
  <record id="work_partners" model="ir.actions.act_window">
    <field name="name">Fișe parteneri - firma curentă</field><field name="res_model">account.move.line</field><field name="view_mode">list,pivot,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0]),('parent_state','=','posted'),('account_id.account_type','in',['asset_receivable','liability_payable'])]</field>
    <field name="context">{'group_by':['partner_id'],'create':False}</field>
  </record>
  <record id="work_employees" model="ir.actions.act_window">
    <field name="name">Angajați - firma curentă</field><field name="res_model">hr.employee</field><field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0])]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0]}</field>
  </record>
  <record id="work_statements" model="ir.actions.act_window">
    <field name="name">Extrase bancare - firma curentă</field><field name="res_model">account.bank.statement</field><field name="view_mode">list,form</field>
    <field name="domain">[('company_id','=',allowed_company_ids[0])]</field>
    <field name="context">{'default_company_id':allowed_company_ids[0]}</field>
    <field name="help" type="html"><p>Adaugă extrasele reale pentru operațiuni noi. La primul extras, completează soldul inițial conform extrasului băncii și verifică-l cu registrul contabil. Operațiunile SAGA sunt deja contabilizate; nu le introduce încă o dată.</p></field>
  </record>
  <menuitem id="menu_work" name="Lucru curent" parent="menu_saga" sequence="0" groups="account.group_account_user"/>
  <menuitem id="menu_work_customers" name="Clienți" parent="menu_work" action="work_customers" sequence="1"/>
  <menuitem id="menu_work_vendors" name="Furnizori" parent="menu_work" action="work_vendors" sequence="2"/>
  <menuitem id="menu_work_sales" name="Facturi clienți" parent="menu_work" action="work_sales" sequence="3"/>
  <menuitem id="menu_work_purchases" name="Facturi furnizori" parent="menu_work" action="work_purchases" sequence="4"/>
  <menuitem id="menu_work_banks" name="Casă și bănci" parent="menu_work" action="work_banks" sequence="5"/>
  <menuitem id="menu_work_ledger" name="Registru casă/bancă" parent="menu_work" action="work_ledger" sequence="6"/>
  <menuitem id="menu_work_statements" name="Extrase bancare" parent="menu_work" action="work_statements" sequence="7"/>
  <menuitem id="menu_work_partners" name="Fișe parteneri" parent="menu_work" action="work_partners" sequence="8"/>
  <menuitem id="menu_work_employees" name="Angajați" parent="menu_work" action="work_employees" sequence="9" groups="hr.group_hr_user"/>
</odoo>
